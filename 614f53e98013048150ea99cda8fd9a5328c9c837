  "ui-command": {
   "id": "ui-command",
   "title": "Run the dashboard with treekeeper ui",
   "description": "The ui command: starts the read-only dashboard on 127.0.0.1 (OS-picked port unless --port), prints the URL, opens the browser unless --no-open, and runs until SIGINT or SIGTERM. With --json it prints the removal history report and exits without starting a server."
  },
  "ui-removal-history": {
   "id": "ui-removal-history",
   "title": "Summarize what treekeeper removed from the event log",
   "description": "Reads reclaim and branch-delete events out of the JSONL log and turns them into totals, a per-repo breakdown, a per-day series and a list of removals for a chosen range (7 days, 30 days, all time)."
  },
  "ui-disk-usage": {
   "id": "ui-disk-usage",
   "title": "Report current disk usage per volume and per repo",
   "description": "Measures the volumes holding the configured roots and, per repo, how many linked worktrees exist, how much disk they occupy and how much of that a sweep could reclaim right now. Read-only: it plans, it never applies."
  },
  "ui-dashboard-page": {
   "id": "ui-dashboard-page",
   "title": "Show removal history, disk usage and daemon state on one page",
   "description": "The dashboard document: headline numbers, per-repo table, per-day chart and removals list for the chosen range, then current disk usage and the daemon line. Self-contained, light and dark, and every dynamic string reaches the DOM as text."
  },
  "ui-server": {
   "id": "ui-server",
   "title": "Serve the dashboard read-only on 127.0.0.1",
   "description": "The HTTP server behind treekeeper ui: the page, a JSON history endpoint and a JSON current-usage endpoint, GET and HEAD only. It refuses any Host other than 127.0.0.1 or localhost on its own port, sends a locked-down Content-Security-Policy, and measures current usage once at a time and caches it."
  }
