{
  "name": "treekeeper",
  "version": "0.1.0",
  "description": "Reclaim disk from finished agent worktrees. Watches git, forge PR state and agent sessions, archives anything unique, then removes what is done.",
  "keywords": [
    "git",
    "worktree",
    "cleanup",
    "gc",
    "disk-space",
    "agent",
    "ai-agent",
    "claude-code",
    "codex",
    "aider",
    "cursor",
    "branches",
    "daemon"
  ],
  "homepage": "https://github.com/yoavshmariahu/treekeeper#readme",
  "bugs": {
    "url": "https://github.com/yoavshmariahu/treekeeper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoavshmariahu/treekeeper.git"
  },
  "license": "MIT",
  "author": "Yoav Shmariahu",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "treekeeper": "dist/cli.js",
    "tk": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
